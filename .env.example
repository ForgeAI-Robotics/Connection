# Populate only your LOCAL .env. Never paste live keys into Git or issues.
CLOUD_API_KEY=
VLM_API_KEY=

# Public documentation addresses: replace locally; not real robot addresses.
DREAM_BASE_URL=http://192.0.2.20:8001
VLA_BASE_URL=http://192.0.2.30:8091
MASTER_URL=http://127.0.0.1:5000
ROBOT_API_URL=http://127.0.0.1:5008
RECEPTION_MODE=mock

# Optional Feishu adapter: disabled from task publication by default.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_TASK_MODE=dry_run
LARK_BRAIN_URL=http://127.0.0.1:8888
LARK_CONFIRM_TIMEOUT=120
LARK_TASK_TIMEOUT=1800
LARK_POLL_INTERVAL=2
LARK_HTTP_TIMEOUT=8
LARK_DB_PATH=integrations/feishu/runtime/feishu.db
LARK_LOG_PATH=integrations/feishu/runtime/feishu.log
LARK_RETENTION_DAYS=30
