[Unit]
Description=FQPlanner Linux control panel
After=network.target
Documentation=file://@ROOT@/web/README.md

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@ROOT@/.env
ExecStart=@PYTHON@ @ROOT@/web/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
