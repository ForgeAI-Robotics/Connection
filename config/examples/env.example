# Populate only your LOCAL .env. Never paste live keys into Git or issues.
CLOUD_API_KEY=
VLM_API_KEY=

# 大脑 / 导航 / 操控 / 真机 IP 只写在 config/networks.yaml，按 active WiFi 取值。
# 留空时按 networks.yaml 解析；仅独立部署才显式覆盖。
MASTER_URL=
CONNECTION_OPS_URL=
ROBOT_API_URL=http://127.0.0.1:5008
RECEPTION_MODE=mock

# Optional Feishu adapter: disabled from task publication by default.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_TASK_MODE=dry_run
LARK_BRAIN_URL=
LARK_CONFIRM_TIMEOUT=120
LARK_TASK_TIMEOUT=1800
LARK_POLL_INTERVAL=2
LARK_HTTP_TIMEOUT=8
LARK_DB_PATH=integrations/feishu/runtime/feishu.db
LARK_RETENTION_DAYS=30

# SSH 目标是配置表里的 用户@IP，不要写主机别名。这里只放密码和远端目录。
DREAM_SSH_PASSWORD=
DREAM_REMOTE_DIR=/home/fq/BJHYZJ_FQ/DREAM

# SIMPLE remote executor (backend key retained as simple_o7; current hand is O6).
SIMPLE_O7_TOKEN=
# Panel controls only our standalone container. Prefer SSH keys.
SIMPLE_SSH_TARGET=fangqi@192.168.31.69
SIMPLE_SSH_PASSWORD=
SIMPLE_REMOTE_DIR=/home/fangqi/connection-simple-o7
